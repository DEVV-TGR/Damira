# Copiar para .env.local (desenvolvimento) e definir no painel da Vercel (produção).
# Os ficheiros .env são lidos da RAIZ do projeto, nunca de src/.

# Endereço público do site, sem barra no fim. Fonte única do domínio: alimenta o
# metadataBase (imagens de partilha), o sitemap.xml, o robots.txt e os dados
# estruturados das duas casas. Ver src/lib/site.ts.
# Sem ela assume-se o subdomínio de demonstração da Vercel.
NEXT_PUBLIC_SITE_URL=

# ─── Pedidos de encomenda ───────────────────────────────────────────────────

# Chave do serviço de email (Resend). Sem ela o formulário continua a funcionar:
# devolve o pedido escrito para a pessoa o enviar do seu próprio correio. Ver
# src/app/[locale]/encomendas/acoes.ts.
RESEND_API_KEY=

# Para onde vão os pedidos. Por defeito, support@devplus.pt — os pedidos de teste
# chegam a quem está a construir o site em vez de tocarem à cozinha.
# ⚠️ É A PRIMEIRA COISA A MUDAR NO DIA DO LANÇAMENTO: um site publicado a mandar
# as encomendas para a agência é uma casa a perder trabalho sem dar por isso.
EMAIL_PEDIDOS=

# Remetente. Tem de ser um domínio verificado no Resend; o onboarding@resend.dev
# é o endereço de testes e só entrega para a conta que criou a chave.
EMAIL_REMETENTE=

# ─── Modo de teste da loja ──────────────────────────────────────────────────

# 1 = a loja corre em modo de teste: prazos e horário de exemplo no calendário,
# Stripe de teste, e uma faixa no topo de todas as páginas a dizê-lo. Só o valor
# 1 liga. Ver src/lib/modo-teste.ts.
# ⚠️ DESLIGA-SE NO DIA DO LANÇAMENTO (#55). E lê-se no build: mudar obriga a
# um novo deploy.
LOJA_EM_TESTE=

# ─── Base de dados (Neon) ───────────────────────────────────────────────────
# ⚠️ É O INTERRUPTOR DA BASE DE DADOS. Com ela, o site lê e grava na Neon; sem
# ela, lê os JSON, como até aqui. Lê-se no build: as páginas públicas geram-se
# a partir da base de dados, e mudá-la obriga a um novo deploy.
# ⚠️ Com ela, a entrada provisória do painel desliga-se (o PIN dela é público):
# a entrada verdadeira liga-se no mesmo deploy, ou o painel fica trancado.
# Na Vercel: Production → ramo `production`; Preview e Development → ramo
# `desenvolvimento`. Em local, o `desenvolvimento`. NUNCA o de produção para
# testar. Ver docs/loja/ligar-a-neon.md.
# O endereço COM pooling, para o site (driver HTTP).
DATABASE_URL=
# O endereço DIRETO, só para os comandos que correm à mão (npm run bd:migrar,
# bd:importar, bd:comparar, painel:pin). Mostram em que base de dados vão
# escrever e pedem um «sim» antes.
DATABASE_URL_UNPOOLED=

# ─── Painel: a entrada provisória ───────────────────────────────────────────

# TUDO OPCIONAL. A entrada provisória liga com LOJA_EM_TESTE=1 e mais nada:
# sem estas variáveis, o PIN é 123456, o gerente é developerplusteam@gmail.com e
# o segredo é um fixo do código (público — ver docs/loja/painel.md). Sem
# LOJA_EM_TESTE=1, o painel fica desligado mesmo com isto preenchido.
# A entrada verdadeira (PIN com hash, tentativas limitadas, código por email)
# chega com a base de dados (#33).

# O PIN da equipa, seis dígitos. Por defeito, 123456.
PAINEL_PIN_TESTE=

# Assina os cookies do painel. Gerar com:  openssl rand -base64 32
# Separado do AUTH_SECRET de propósito: o painel e a conta não se misturam.
PAINEL_SEGREDO=

# Os emails que entram como gerente, separados por vírgulas. Na entrada de
# teste o código aparece no ecrã em vez de ir por email.
# ⚠️ COM A BASE DE DADOS (DATABASE_URL), esta é a lista da entrada VERDADEIRA,
# e não tem valor por defeito: vazia, ninguém é gerente. O código vai por email
# (RESEND_API_KEY, EMAIL_REMETENTE) e nunca aparece no ecrã.
EMAILS_GERENTE=

# ─── Conta de cliente ───────────────────────────────────────────────────────

# ⚠️ TUDO O QUE VEM A SEGUIR É OPCIONAL. Sem estas variáveis o site funciona
# exactamente como funcionava: não aparece botão de entrar, /entrar e /conta
# respondem 404, e encomenda-se na mesma. A conta nunca é obrigatória para
# encomendar, e é a única regra desta funcionalidade que não se negoceia.
#
# ⚠️ E são lidas no BUILD, não a pedido: as páginas são geradas estaticamente,
# portanto ligar a conta obriga a um novo deploy.

# Segredo que assina o cookie da sessão. Gerar com:  openssl rand -base64 32
# Sem ele a conta fica desligada mesmo que as chaves abaixo estejam preenchidas
# — um botão de entrar que rebenta depois de a pessoa escolher a conta do Google
# é o pior sítio possível para falhar.
AUTH_SECRET=

# Google — consola em https://console.cloud.google.com/apis/credentials
# Tipo "OAuth client ID", aplicação Web. O URI de redirecionamento autorizado é
#   https://<dominio>/api/auth/callback/google
# e, para desenvolvimento,  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook — https://developers.facebook.com/apps, produto "Facebook Login".
#   https://<dominio>/api/auth/callback/facebook
# ⚠️ O Facebook exige HTTPS mesmo em testes e não aceita localhost: para
# desenvolver, ou se usa um túnel, ou se testa só com o Google.
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
