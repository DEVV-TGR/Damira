# Copiar para .env.local (desenvolvimento) e definir no painel da Vercel (produção).
# Os ficheiros .env são lidos da RAIZ do projeto, nunca de src/.

# Endereço público do site, sem barra no fim. Fonte única do domínio: alimenta o
# metadataBase (imagens de partilha), o sitemap.xml, o robots.txt e os dados
# estruturados das duas casas. Ver src/lib/site.ts.
# Sem ela assume-se o subdomínio de demonstração da Vercel.
NEXT_PUBLIC_SITE_URL=

# ─── Pedidos de encomenda ───────────────────────────────────────────────────

# Chave do serviço de email (Resend). Sem ela o formulário continua a funcionar:
# devolve o pedido escrito para a pessoa o enviar do seu próprio correio. Ver
# src/app/[locale]/encomendas/acoes.ts.
RESEND_API_KEY=

# Para onde vão os pedidos. Por defeito, support@devplus.pt — os pedidos de teste
# chegam a quem está a construir o site em vez de tocarem à cozinha.
# ⚠️ É A PRIMEIRA COISA A MUDAR NO DIA DO LANÇAMENTO: um site publicado a mandar
# as encomendas para a agência é uma casa a perder trabalho sem dar por isso.
EMAIL_PEDIDOS=

# Remetente. Tem de ser um domínio verificado no Resend; o onboarding@resend.dev
# é o endereço de testes e só entrega para a conta que criou a chave.
EMAIL_REMETENTE=
