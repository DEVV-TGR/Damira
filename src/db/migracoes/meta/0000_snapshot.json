      "checkConstraints": {
        "produtos_id_formato": {
          "name": "produtos_id_formato",
          "value": "\"produtos\".\"id\" ~ '^[a-z0-9-]+$'"
        },
        "produtos_origem": {
          "name": "produtos_origem",
          "value": "\"produtos\".\"origem\" in ('ementa', 'encomendas')"
        },
        "produtos_familia": {
          "name": "produtos_familia",
          "value": "\"produtos\".\"familia\" in ('ementa', 'festa', 'bolo', 'box', 'medida')"
        },
        "produtos_familia_da_origem": {
          "name": "produtos_familia_da_origem",
          "value": "(\"produtos\".\"origem\" = 'ementa') = (\"produtos\".\"familia\" = 'ementa')"
        },
        "produtos_ementa_com_carta": {
          "name": "produtos_ementa_com_carta",
          "value": "\"produtos\".\"familia\" <> 'ementa' or (\"produtos\".\"carta\" is not null and \"produtos\".\"categoria\" is not null)"
        },
        "produtos_unidade": {
          "name": "produtos_unidade",
          "value": "\"produtos\".\"unidade\" in ('un', 'kg')"
        },
        "produtos_descricao_pt": {
          "name": "produtos_descricao_pt",
          "value": "\"produtos\".\"descricao_en\" is null or \"produtos\".\"descricao_pt\" is not null"
        },
        "produtos_tempo_producao_par": {
          "name": "produtos_tempo_producao_par",
          "value": "(\"produtos\".\"tempo_producao_unidade\" is null) = (\"produtos\".\"tempo_producao_valor\" is null)"
        },
        "produtos_tempo_producao": {
          "name": "produtos_tempo_producao",
          "value": "\"produtos\".\"tempo_producao_unidade\" in ('horas', 'dias') and \"produtos\".\"tempo_producao_valor\" >= 0"
        },
        "produtos_minimo_e_multiplo": {
          "name": "produtos_minimo_e_multiplo",
          "value": "\"produtos\".\"quantidade_minima\" > 0 and \"produtos\".\"multiplo\" > 0"
        },
        "produtos_sinal": {
          "name": "produtos_sinal",
          "value": "\"produtos\".\"sinal_percent\" between 1 and 100"
        },
        "produtos_limite_par": {
          "name": "produtos_limite_par",
          "value": "(\"produtos\".\"limite_quantidade\" is null) = (\"produtos\".\"limite_modo\" is null)"
        },
        "produtos_limite": {
          "name": "produtos_limite",
          "value": "\"produtos\".\"limite_quantidade\" > 0 and \"produtos\".\"limite_modo\" in ('porDia', 'total')"
        }
      },
